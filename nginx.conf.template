server {
  listen ${PORT};
  server_name _;

  root /usr/share/nginx/html;

  location = /health {
    add_header Content-Type text/plain;
    return 200 "ok";
  }

  location = / {
    return 302 /one-page-demo/;
  }

  location /one-page-demo/ {
    try_files $uri $uri/ /one-page-demo/index.html;
  }

  location ~* ^/one-page-demo/.*\.(css|js|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2)$ {
    expires 1h;
    add_header Cache-Control "public, max-age=3600";
    try_files $uri =404;
  }
}
